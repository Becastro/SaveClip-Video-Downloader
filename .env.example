# Port where the SaveClip web app is exposed
APP_PORT=8080

# Public network request limits
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Maximum accepted media duration and size
MAX_DURATION_SECONDS=7200
MAX_FILE_SIZE_BYTES=2147483648

# Maximum simultaneous downloads in the standalone app (1-4).
# In Docker, scale worker replicas to control RQ concurrency.
MAX_CONCURRENT_DOWNLOADS=2

# Optional output filename template. Fields: {title}, {id}, {uploader}
OUTPUT_TEMPLATE={title} - {id}

# Delete temporary download files after 25 minutes (15-30 minutes recommended)
FILE_TTL_MINUTES=25

# Browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Optional comma-separated trusted platform domains supported by yt-dlp
EXTRA_ALLOWED_DOMAINS=

LOG_LEVEL=INFO
